)\n                   - COALESCE(SUM(CASE WHEN t2.type = 'deduction' THEN t2.amount ELSE 0 END),0)\n            FROM salary_transactions t2 WHERE t2.driver_id = d.id AND t2.month = 6 AND t2.year = 2026) as prev_carry\n    FROM drivers d\n    WHERE d.status = 'active' \n    ORDER BY d.name ASC\n    LIMIT 100 OFFSET 0","timestamp":"2026-10-02T18:58:45.334Z"}
