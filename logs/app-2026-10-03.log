{"level":"debug","message":"Executing (default): SELECT d.id, d.name,\n           COALESCE((SELECT daily_rate FROM sub_vendor_driver_rate_history WHERE driver_id = d.id AND effective_date <= LAST_DAY(STR_TO_DATE(CONCAT(2099, '-', LPAD(3, 2, '0'), '-01'), '%Y-%m-%d')) ORDER BY effective_date DESC LIMIT 1), d.daily_rate) as daily_rate,\n           (SELECT COUNT(*) FROM sub_vendor_attendance a WHERE a.driver_id = d.id AND MONTH(a.date) = 3 AND YEAR(a.date) = 2099 AND a.status = 'present') as days_present,\n           (SELECT COUNT(*) FROM sub_vendor_attendance a WHERE a.driver_id = d.id AND MONTH(a.date) = 3 AND YEAR(a.date) = 2099 AND a.status = 'absent') as days_absent,\n           (SELECT COALESCE(SUM(t.amount),0) FROM sub_vendor_salary_transactions t WHERE t.driver_id = d.id AND t.month = 3 AND t.year = 2099 AND t.type = 'advance') as month_advance,\n           (SELECT GROUP_CONCAT(DISTINCT DATE_FORMAT(COALESCE(t.payment_date, t.created_at), '%d %b') ORDER BY COALESCE(t.payment_date, t.created_at) ASC SEPARATOR ', ') FROM sub_vendor_salary_transactions t WHERE t.driver_id = d.id AND t.month = 3 AND t.year = 2099 AND t.type = 'advance') as advance_dates,\n           (SELECT COALESCE(SUM(t.amount),0) FROM sub_vendor_salary_transactions t WHERE t.driver_id = d.id AND t.month = 3 AND t.year = 2099 AND t.type IN ('payment', 'monthly_salary', 'weekly_salary')) as total_paid,\n           (SELECT COALESCE(SUM(t.amount),0) FROM sub_vendor_salary_transactions t WHERE t.driver_id = d.id AND t.month = 3 AND t.year = 2099 AND t.type = 'deduction') as total_deduction,\n           (SELECT GROUP_CONCAT(DISTINCT DATE_FORMAT(COALESCE(t.payment_date, t.created_at), '%d %b') ORDER BY COALESCE(t.payment_date, t.created_at) ASC SEPARATOR ', ') FROM sub_vendor_salary_transactions t WHERE t.driver_id = d.id AND t.month = 3 AND t.year = 2099 AND t.type = 'deduction') as deduction_dates,\n           (SELECT COALESCE(SUM(CASE WHEN t2.type = 'advance' THEN t2.amount ELSE 0 END),0)\n                   + COALESCE(SUM(CASE WHEN t2.type = 'carry_forward' THEN t2.amount ELSE 0 END),0)\n                   - COALESCE(SUM(CASE WHEN t2.type = 'deduction' THEN t2.amount ELSE 0 END),0)\n            FROM sub_vendor_salary_transactions t2 WHERE t2.driver_id = d.id AND t2.month = 2 AND t2.year = 2099) as prev_carry\n    FROM sub_vendor_drivers d\n    WHERE d.status = 'active' AND d.name LIKE '%ZZTEST SV%'\n    ORDER BY d.name ASC\n    LIMIT 30 OFFSET 0","timestamp":"2026-10-02T19:12:32.324Z"}
